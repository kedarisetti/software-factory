{
  "version": 2,
  "sources": [
    {
      "name": "team-chat",
      "kind": "webhook",
      "chat": true,
      "verify": {
        "secret_env": "SF_CHAT_SIGNING_SECRET",
        "header": "X-Slack-Signature",
        "prefix": "v0=",
        "signed": "v0:{header:X-Slack-Request-Timestamp}:{body}",
        "timestamp_header": "X-Slack-Request-Timestamp",
        "max_skew_s": 300
      },
      "challenge": {
        "when": {
          "/type": "url_verification"
        },
        "reply": "/challenge"
      },
      "events": {
        "only": [
          {
            "/type": "event_callback",
            "/event/type": [
              "message",
              "app_mention"
            ]
          }
        ],
        "ignore": [
          {
            "/event/bot_id": {
              "exists": true
            }
          },
          {
            "/event/subtype": {
              "exists": true
            }
          },
          {
            "/event/user": "U0FACTORY"
          },
          {
            "/event/type": "message",
            "/event/text": {
              "contains": "<@U0FACTORY>"
            }
          }
        ],
        "map": {
          "id": "{/event/channel}/{/event/ts}",
          "text": "/event/text",
          "actor": "/event/user",
          "channel": "/event/channel",
          "dedupe": "{/event_id}"
        },
        "workflow": [
          {
            "command": {
              "mention": "<@U0FACTORY>"
            }
          },
          {
            "by_channel": {
              "C0FACTORY": "demo"
            }
          }
        ]
      }
    },
    {
      "name": "gh-issues-hook",
      "kind": "webhook",
      "chat": false,
      "verify": {
        "secret_env": "SF_GH_WEBHOOK_SECRET",
        "header": "X-Hub-Signature-256",
        "prefix": "sha256="
      },
      "events": {
        "only": [
          {
            "header:X-GitHub-Event": "issues",
            "/action": [
              "opened",
              "labeled",
              "reopened"
            ]
          }
        ],
        "map": {
          "id": "{/repository/full_name}#{/issue/number}",
          "title": "/issue/title",
          "text": "/issue/body",
          "actor": "/sender/login",
          "channel": "/repository/full_name",
          "labels": "/issue/labels",
          "url": "/issue/html_url",
          "dedupe": "{header:X-GitHub-Delivery}"
        },
        "workflow": [
          {
            "label_prefix": {
              "prefix": "factory:",
              "from": "/label/name"
            }
          },
          {
            "label_prefix": {
              "prefix": "factory:"
            }
          }
        ]
      }
    },
    {
      "name": "gh-issues",
      "kind": "command",
      "command": [
        "gh",
        "api",
        "--method",
        "GET",
        "repos/kedarisetti/software-factory/issues?state=open&sort=updated&direction=asc&per_page=100&since={cursor}"
      ],
      "env": {
        "GH_TOKEN": "${SF_GH_TOKEN}"
      },
      "poll_interval_s": 300,
      "timeout_ms": 30000,
      "chat": false,
      "cursor": "max:updated_at",
      "cursor_start": "1970-01-01T00:00:00Z",
      "events": {
        "items": "",
        "ignore": [
          {
            "/pull_request": {
              "exists": true
            }
          }
        ],
        "map": {
          "id": "kedarisetti/software-factory#{/number}",
          "title": "/title",
          "text": "/body",
          "actor": "/user/login",
          "channel": "kedarisetti/software-factory",
          "labels": "/labels",
          "url": "/html_url",
          "updated_at": "/updated_at",
          "dedupe": "{/number}"
        },
        "workflow": [
          {
            "label_prefix": {
              "prefix": "factory:"
            }
          }
        ]
      }
    },
    {
      "name": "linear",
      "kind": "mcp",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp"
      ],
      "env": {
        "LINEAR_API_KEY": "${SF_LINEAR_API_KEY}"
      },
      "tool": "list_issues",
      "arguments": {
        "updatedAt": "{cursor}",
        "limit": 50
      },
      "poll_interval_s": 300,
      "timeout_ms": 30000,
      "chat": false,
      "cursor": "max:updated_at",
      "cursor_start": null,
      "events": {
        "items": "/issues",
        "map": {
          "id": "/identifier",
          "title": "/title",
          "text": "/description",
          "actor": "/creator/name",
          "channel": "/team/key",
          "labels": "/labels",
          "url": "/url",
          "updated_at": "/updatedAt"
        },
        "workflow": [
          {
            "default": "triage"
          }
        ]
      }
    }
  ],
  "permissions": {
    "deploy_workflows": [
      "ship"
    ],
    "rules": [
      {
        "source": "team-chat",
        "channel": "C0FACTORY",
        "workflows": [
          "demo",
          "triage"
        ]
      },
      {
        "source": "gh-issues-hook",
        "channel": "kedarisetti/software-factory",
        "workflows": [
          "triage",
          "demo",
          "ship"
        ]
      },
      {
        "source": "gh-issues",
        "channel": "kedarisetti/software-factory",
        "workflows": [
          "triage",
          "demo",
          "ship"
        ]
      },
      {
        "source": "linear",
        "channel": "ENG",
        "workflows": [
          "triage"
        ]
      }
    ]
  },
  "rate": {
    "window_ms": 3600000,
    "per_source": {
      "team-chat": 60,
      "gh-issues-hook": 60,
      "gh-issues": 60,
      "linear": 60
    },
    "per_actor": 20
  },
  "near_dup_window_ms": 600000,
  "priority": {
    "base": {
      "gh-issues-hook": 10,
      "gh-issues": 10,
      "team-chat": 5,
      "linear": 8
    },
    "rules": [
      {
        "name": "p0",
        "labels": [
          "p0",
          "priority:p0"
        ],
        "keywords": [
          "p0"
        ],
        "score": 100
      },
      {
        "name": "incident",
        "labels": [
          "incident",
          "sev1"
        ],
        "keywords": [
          "incident",
          "outage"
        ],
        "score": 80
      },
      {
        "name": "urgent",
        "labels": [
          "urgent"
        ],
        "keywords": [
          "urgent",
          "asap"
        ],
        "score": 50
      },
      {
        "name": "p2",
        "labels": [
          "p2",
          "priority:p2"
        ],
        "keywords": [],
        "score": -20
      },
      {
        "name": "nice-to-have",
        "labels": [
          "nice-to-have"
        ],
        "keywords": [
          "nice to have"
        ],
        "score": -30
      }
    ]
  },
  "budget": {
    "run_tokens": 50000,
    "run_usd_micros": 5000000,
    "daily_tokens": 500000,
    "daily_usd_micros": 20000000
  }
}
